{
  "manifest_version": 3,
  "name": "YouTube Transcript Chatbot",
  "version": "1.0",
  "description": "Ask questions about the current YouTube video's transcript.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
