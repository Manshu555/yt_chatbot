GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_available_gemini_model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BATCH_MODEL=gpt-4.1-mini
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

TOP_K_TRANSCRIPT=5
TOP_K_WEB=3
TOP_K_WEB_DISPLAY=3
TOP_K_EVIDENCE=5

WEB_TIMEOUT_SECONDS=3
PAGE_FETCH_TIMEOUT_SECONDS=3
LLM_TIMEOUT_SECONDS=30
GEMINI_CALL_TIMEOUT_SECONDS=40
REQUEST_TIMEOUT_SECONDS=150
TRANSCRIPT_TIMEOUT_SECONDS=20

VALIDATION_ENABLED_BY_DEFAULT=true
MAX_CLAIMS=3

# Local all-MiniLM-L6-v2 cosine similarity thresholds (range -1 to 1).
TRANSCRIPT_MIN_SIMILARITY=0.25
WEB_MIN_SIMILARITY=0.45
# Drop pages substantially less relevant than the best eligible content match.
WEB_MAX_SIMILARITY_GAP=0.15
# Minimum question-term coverage when external embeddings fail.
WEB_MIN_LEXICAL_COVERAGE=0.5
WEB_CANDIDATE_COUNT=10
